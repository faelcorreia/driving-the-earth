[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libdriving_the_earth_ext.so"
linux.release.x86_64 = "res://../target/release/libdriving_the_earth_ext.so"
windows.release.x86_64 = "res://../target/release/driving_the_earth_ext.dll"
macos.release = "res://../target/release/libdriving_the_earth_ext.dylib"
